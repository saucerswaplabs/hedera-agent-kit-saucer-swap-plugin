{
  "name": "saucer-swap-plugin",
  "version": "0.3.0",
  "type": "module",
  "description": "SaucerSwap plugin for Hedera Agent Kit",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "hedera",
    "saucerswap",
    "defi",
    "plugin",
    "agent-kit"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bignumber.js": "^9.3.1",
    "ethers": "^6.15.0",
    "zod": "^3.0.0"
  },
  "peerDependencies": {
    "@hashgraph/hedera-agent-kit": "^4.0.0",
    "@hiero-ledger/sdk": "^2.82.0"
  },
  "devDependencies": {
    "@hashgraph/hedera-agent-kit": "^4.1.0",
    "@hiero-ledger/sdk": "^2.87.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.0"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/saucerswaplabs/hedera-agent-kit-saucer-swap-plugin"
  }
}
